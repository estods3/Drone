<?xml version="1.0"?>
<robot name="quadcopter_x">

  <!-- Base Link (Main Body) -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.15 0.0254 0.02"/>
      </geometry>
      <material name="body_material">
        <color rgba="0.0 0.0 0.0 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.15 0.0254 0.02"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!-- Front Right Arm -->
  <link name="arm_front_right">
    <visual>
      <origin xyz="0.055 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.11 0.005 0.005"/>
      </geometry>
      <material name="arm_material">
        <color rgba="0.0 0.0 0.0 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.055 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.11 0.005 0.005"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.055 0 0" rpy="0 0 0"/>
      <mass value="0.02"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- Front Left Arm -->
  <link name="arm_front_left">
    <visual>
      <origin xyz="0.055 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.11 0.005 0.005"/>
      </geometry>
      <material name="arm_material">
        <color rgba="0.0 0.0 0.0 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.055 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.11 0.005 0.005"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.055 0 0" rpy="0 0 0"/>
      <mass value="0.02"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- Rear Right Arm -->
  <link name="arm_rear_right">
    <visual>
      <origin xyz="0.055 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.11 0.005 0.005"/>
      </geometry>
      <material name="arm_material">
        <color rgba="0.0 0.0 0.0 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.055 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.11 0.005 0.005"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.055 0 0" rpy="0 0 0"/>
      <mass value="0.02"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- Rear Left Arm -->
  <link name="arm_rear_left">
    <visual>
      <origin xyz="0.055 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.11 0.005 0.005"/>
      </geometry>
      <material name="arm_material">
        <color rgba="0.0 0.0 0.0 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.055 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.11 0.005 0.005"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.055 0 0" rpy="0 0 0"/>
      <mass value="0.02"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- Propeller Links -->
  <link name="prop_front_right">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.12 0.007 0.002"/>
      </geometry>
      <material name="prop_material">
        <color rgba="0.0 0.8 0.0 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.12 0.007 0.002"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <link name="prop_front_left">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.12 0.007 0.002"/>
      </geometry>
      <material name="prop_material">
        <color rgba="0.0 0.8 0.0 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.12 0.007 0.002"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <link name="prop_rear_right">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.12 0.007 0.002"/>
      </geometry>
      <material name="prop_material">
        <color rgba="0.0 0.8 0.0 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.12 0.007 0.002"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <link name="prop_rear_left">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.12 0.007 0.002"/>
      </geometry>
      <material name="prop_material">
        <color rgba="0.0 0.8 0.0 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.12 0.007 0.002"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <!-- Joints connecting arms to body -->
  <joint name="arm_front_right_joint" type="fixed">
    <parent link="base_link"/>
    <child link="arm_front_right"/>
    <origin xyz="0 0 0" rpy="0 0 0.7854"/>
  </joint>

  <joint name="arm_front_left_joint" type="fixed">
    <parent link="base_link"/>
    <child link="arm_front_left"/>
    <origin xyz="0 0 0" rpy="0 0 2.3562"/>
  </joint>

  <joint name="arm_rear_right_joint" type="fixed">
    <parent link="base_link"/>
    <child link="arm_rear_right"/>
    <origin xyz="0 0 0" rpy="0 0 -0.7854"/>
  </joint>

  <joint name="arm_rear_left_joint" type="fixed">
    <parent link="base_link"/>
    <child link="arm_rear_left"/>
    <origin xyz="0 0 0" rpy="0 0 -2.3562"/>
  </joint>

  <!-- Joints connecting propellers to arms -->
  <joint name="prop_front_right_joint" type="continuous">
    <parent link="arm_front_right"/>
    <child link="prop_front_right"/>
    <origin xyz="0.11 0 0.01" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <joint name="prop_front_left_joint" type="continuous">
    <parent link="arm_front_left"/>
    <child link="prop_front_left"/>
    <origin xyz="0.11 0 0.01" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <joint name="prop_rear_right_joint" type="continuous">
    <parent link="arm_rear_right"/>
    <child link="prop_rear_right"/>
    <origin xyz="0.11 0 0.01" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <joint name="prop_rear_left_joint" type="continuous">
    <parent link="arm_rear_left"/>
    <child link="prop_rear_left"/>
    <origin xyz="0.11 0 0.01" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

</robot>